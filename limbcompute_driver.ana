@limbcompute3.ana
rguess = 1600
rrange = 100
files_file = getenv('FILES_FILE')
out_file = getenv('OUT_FILE')
luninp = get_lun()
stat = openr(luninp, files_file)
lunout = get_lun()
stat = openw(lunout, out_file)
if stat ne 1 then {
  errormess,sprintf('can''t open %s for writing.\n', out_file)
  exit, 1
}
roff = fltarr(4501)
roff(94) = 6.0
roff(131) = 6.25
roff(171) = 8.0
roff(193) = 9.0
roff(211) = 9.5
roff(304) = 18.0
roff(335) = 9.5
roff(1600) = 0.0
roff(1700) = -1.0
roff(4500) = -2.25
fnam = ''
first = 1
while readf(luninp, fnam) eq 1 do {
  dataread2, x, fnam, hdr
  ;ty, $data_time_tai
  wl = fits_key(hdr, 'wavelnth')
  $limbmode = 0
  if wl gt 1000 then $limbmode = 1
  if wl gt 2000 then $limbmode = 2
  if wl eq 304 then $limbmode = 3
  $sdisk_xc=fits_key(hdr, 'CRPIX1')
  $sdisk_yc=fits_key(hdr, 'CRPIX2')
  t_obs = fits_key(hdr, 'T_OBS')
  nc = sscanf(t_obs, '%d-%d-%dT%d:%d:%d', y, m, d, h, m, s)
  ut = tai_from_date(y, doy(y, m, d), h, m, s) + 220924766
  if first eq 1 then {
    rguess = sun_r(doy(y, m, d), y)/0.6 + roff(wl)
    first = 0
  }
  limbcompute3, x, rguess, rrange
  outstr = sprintf('%7.2f\t%7.2f\t%7.2f\t%d\t%s', $sdisk_xc, $sdisk_yc, $sdisk_r, ut, t_obs)
  printf, lunout, outstr
}
exit, 0
