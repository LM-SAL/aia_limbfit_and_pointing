$useprevflag  = 0
$tweak304flag  = 0
$tweak304flag2  = 0
$bumprflag = 1
$keepfaint = 300
lastxc=2047.5
lastyc=2047.5
$sdisk_xc=2047.5
$sdisk_yc=2047.5
rrange = 100
rguess = 1600
;updated 8/10/2010 with code from limbtests.ana, see oldlimbcompute.ana for previous
 ;===============================================================================
subr zeroinonlimb, inlimb, nx, dr, g
  ;suppose we have a good circle and find points near it from our set in inlimb
  ;and fit these to make a better circle (we hope)
  ;use value of g as weight
  ;the currrent circle fit is assumed in globals
  ixlimb = inlimb % nx
  iylimb = inlimb / nx
  rdlimb = sqrt( (ixlimb-$sdisk_xc)^2 + (iylimb-$sdisk_yc)^2) - $sdisk_r
  in2use  = sieve(abs(rdlimb) lt dr)
  in4 = inlimb(in2use)
  ixlimb = ixlimb(in2use)
  iylimb = iylimb(in2use)
  w = g(in2use)
  w = w / mean(w)
  np = num_elem(ixlimb)
  $scounts = np
  ;;if $showflag gt 3 then ty, '# of points in range = ', np
  if np lt 3 then { ty,'zeroinonlimb got too few points', np  return }
  ;w = zero(fltarr(np)) + 1.0
  circle_fit_lsq, ixlimb, iylimb, w, $sdisk_xc, $sdisk_yc, $sdisk_r, $chicircle
  ;;if $showflag gt 3 then ty,'fit ', $sdisk_xc, $sdisk_yc, $sdisk_r, $chicircle
  endsubr
  ;==============================================================================
func parabolicmax5(x)
  ;x is a 1-D vector, do a parabolic fit for 5 points around max and return
  ;max position including fractional value
  i = maxloc(x)
  i = i(0)
  nx = dimen(x,0)
  if nx lt 5 then {
    ty,'parabolicmax5 input too small for fit, using max index only, no interpolation'
    xq = maxloc(x)  xq = xq(0)
  } else {
    if (i+2) ge nx then i = nx - 3
    if i lt 2 then i = 2
    xs = x( (i-2):(i+2))
    c = pit(indgen(xs), xs, 2)
    if c(2) eq 0.0 then {
      ty,'parabolicmax5 - singularity, using max index only, no interpolation'
      xq = maxloc(x)  xq = xq(0)
      if $showflag gt 1 then ty, 'x values', x
      if $showflag gt 1 then ty,'return value', xq
      return, xq
    }
    xq = - c(1)*.5/c(2)
    xq = xq + i - 2
    $cp = c	;keep as global for further display if needed
  }
  return, xq
  endfunc
 ;===============================================================================
func minihough(ixlimb, iylimb, niter)
  ;7/8/2011 - do the iterations here
  ;8/11/2010 version, improved array handling, could be upgraded to use g as weight
  ;but presently uses only frequency (counts)
  ;assumes current best fit in globals, gets all within 1 pixel in r from center
  ;as our measure over a range of centers and r
  ;inlimb is a subset of indices from the original image that are points we
  ;consider, usually the results of an edge selection
  niter = niter > 1
  nc = num_elem(ixlimb)
  if $showflag gt 1 then ty,'minihough, nc =', nc, '   niter = ', niter
  nxc = 11    nyc = 11    nrc = 11
  mhcount = zero(fltarr(nxc, nyc))
  mhrval = zero(fltarr(nxc, nyc))
  //mhgval = zero(fltarr(nxc, nyc))  ;not used presently
  redim, ixlimb, nc, 1
  redim, iylimb, nc, 1

  for k =0, niter-1 do {
    xc = $sdisk_xc + indgen(fltarr(nxc)) - nxc/2
    yc = $sdisk_yc + indgen(fltarr(nyc)) - nyc/2
    redim, xc, 1, nxc
    redim, yc, 1, nyc
    rdx = (ixlimb - xc)^2
    rdy = (iylimb - yc)^2
    for ixc = 0, nxc-1 do for iyc = 0, nyc-1 do {
      rdlimb = sqrt( rdx(*,ixc) + rdy(*,iyc) )
      rdlimb = rfix(rdlimb - $sdisk_r)
      ;;key_locations, rdlimb, rval, rcounts, rsegs
      ;we don't have to populate the whole cube, we just need to keep
      ;the max r value and location for this (ixc, iyc)
      ;;ir = maxloc(rcounts)
      ;;ir = ir(0)
      ;save the max freq (counts) and the corresponding value
      ;;mhcount(ixc, iyc) = rcounts(ir)
      ;;mhrval(ixc, iyc) = rval(ir)
      ;use hist until we need g weights, it is a bit faster than key_locations
      hr = hist(rdlimb)
      ;;ir = maxloc(hr)
      ;;ir = ir(0)
      ;save the max freq (counts) and the corresponding value
      mhcount(ixc, iyc) = max(hr)
      ;;mhrval(ixc, iyc) = ir + !histmin
    }
  //  if $showflag gt 2 then ty, 'mhcount = ', mhcount
  //  if $showflag gt 2 then ty, 'mhrval = ', mhrval
    mx = maxloc(mhcount)
  //  if $showflag gt 2 then ty,'mx = ', mx
    ix = mx(0)
    iy = mx(1)
  //  if $showflag gt 3 then ty,'counted max found at  ', mx(0), mx(1), mhrval(ix, iy)
  //  if $showflag gt 3 then ty,'value = ', max(mhcount)
    $scounts = max(mhcount)

    ;;dr = mhrval(ix, iy)
    dx = xc(ix) - $sdisk_xc
    dy = yc(iy) - $sdisk_yc
  //  if $showflag gt 3 then ty,'initial dx,dy,dr =', dx,dy,dr
    ;interpolate to get a sub-pixel result
    if ix le 0 or ix ge (nxc-1) then {
      ty, 'x center max at edge, no interpolation, Hough dx, dy =', dx, dy   return, 1 }
    if iy le 0 or iy ge (nyc-1) then {
      ty, 'y center max at edge, no interpolation, Hough dx, dy =', dx, dy   return, 1 }
  //  if $showflag gt 2 then ty,'values around (x,y) max =', mhrval((ix-1):(ix+1),(iy-1):(iy+1))
    getmin9,-mhcount((ix-1):(ix+1),(iy-1):(iy+1)), xc1, yc1
  //  xport, 61, 330,110
  //  tv, expand(mhcount(ir-1,*,*), 10),0,0,61
  //  tv, expand(mhcount(ir,*,*), 10),110,0,61
  //  tv, expand(mhcount(ir+1,*,*), 10),220,0,61
  //  if $showflag gt 2 then ty, 'xc1, yc1 =', xc1, yc1
    ;damp
    dx = (dx + xc1) * 0.5
    dy = (dy + yc1) * 0.5
    ;and now use the dx, dy to re-compute r
    rdlimb = sqrt( (ixlimb-($sdisk_xc+dx))^2 + (iylimb-($sdisk_yc+dy))^2)
    rdlimb = rfix(rdlimb - $sdisk_r)
    hr = hist(rdlimb)
    ;find the index for zero offset
    izip = - !histmin
  //  xport, 60
  //  plot, indgen(hr) +!histmin, hr, 3
    ;;rx = parabolicmax7(hr) - izip
    rx = parabolicmax5(hr) - izip
  //  oplot, [rx,rx], [!myb,!myt]
    dr = rx * 0.5
    if $showflag gt 1 then ty,'Hough dx, dy, dr =', dx, dy, dr, rx
    ;apply and do another fit, but check for problems and convergence
    if abs(dr) gt 100 then { ty,'seem to be diverging, give up'  break  }
    $sdisk_xc += dx
    $sdisk_yc += dy
    $sdisk_r += dr
    $xcenters = [$xcenters, $sdisk_xc]
    $ycenters = [$ycenters, $sdisk_yc]
    $radiai = [$radiai,$sdisk_r]
    $pcounts = [$pcounts, $scounts]
    if k gt 1 then
      if ((dx*dx + dy*dy) lt 0.0002) and (abs(dr) lt 0.01) then { ty,'close enough, k = ',k  break }
  }    
  return, 0
  endfunc
 ;===============================================================================
subr limbcompute3, x, rguess, rrange
  ;where x is the raw image
  ;rguess is approx size of r in pixels, rrange is +/- range to use
  ;the guess for the center is expected in $sdisk_xc, $sdisk_yc unless
  ;$dofirstcut is set
  t0 = !systime
  t1 = !systime
  !fz = 1
  zeroifundefined, $limbmode, $showflag, $sampleflag
  zeroifundefined, $dofirstcut, $missvals
  ;if image is expected to be off center, set global $dofirstcut = 1
  if $dofirstcut then {
    firstcut, x
  }
  xcguess = $sdisk_xc
  ycguess = $sdisk_yc
  
  nx = dimen(x,0)   ny = dimen(x,1)
  ;check if we can re-use the annulus calculation and mask calculations
  makeannflag = 1
  r1 = rguess - rrange
  r2 = rguess + rrange
  if defined(inann) then {
    if r1 eq lastr1 and r2 eq lastr2 then {
      ;for the center, just have to be close, try 10
      if abs(lastxc-xcguess) le 10 and abs(lastyc-ycguess) le 10 then makeannflag = 0
    }
  }
 if $showflag gt 1 then ty,'mark 1'
  if makeannflag then {
    ;use a larger range for the smooth mask
    r1s = r1 - 7
    r2s = r2 + 7
    lastr1 = r1
    lastr2 = r2
    lastxc = xcguess
    lastyc = ycguess
    ixnann = indgen(x,0) - xcguess
    iynann = indgen(x,1) - ycguess
    rs = ixnann^2 + iynann^2				;all the r's
    inanns = sieve( rs gt r1s^2 and rs lt r2s^2 )	;for smooth
    inann = sieve( rs gt r1^2 and rs lt r2^2 )		;final
    mask = zero(bytarr(nx, ny))
    masks =  mask
    mask2 =  mask
    mask(inann) = 1
    masks(inanns) = 1
    ;inann is the annulus coordinates from the full array
    ;for the UV we need another mask
    inann2 = sieve( rs gt (r1-1)^2 and rs lt (r2+1)^2 )	;only for UV
    mask2(inann2) = 1					;ditto
    ixnann = inann % nx   iynann = inann/nx
    ;take out any too close to an edge
    margin = 25
    inq = sieve(ixnann gt margin and ixnann lt (4095-margin) and iynann gt margin and iynann lt (4095-margin))
    ixnann = ixnann(inq)  iynann = iynann(inq)
    inann = inann(inq)
    ;also have to exclude corners
    rmax = 2100
    rsc = (ixnann - nx/2)^2 + (iynann - ny/2)^2
    inq = sieve(rsc lt rmax*rmax)
    rsc = 0
    ixnann = ixnann(inq)  iynann = iynann(inq)
    inann = inann(inq)
    annth = #r2d * atan2(iynann - ycguess, ixnann - xcguess)
    ;annthr is the opposite direction in case we ever need it, use for 4500
    annthr = annth + 180
    annthr = annthr - (annthr gt 180)*360.
    thann = rfix(annth)		;thann is a set for sectoring into 1 degree slots
    ;convert to 0-360 range
    thann = thann + (thann lt 0)*360
    ;thann is an array of theta in degrees for annulus points (mask)
    key_locations, thann, values, counts, in4annulus
    ;check for sectors with low populations, these are cropped by an edge, we expect a
    ;broad max in counts (all full sectors will have close to the same #), so just eliminate
    ;all with < max(counts)*.75 for a trial
    xq = 0.75 * max(counts)
    nz = num_elem(in4annulus)
    in2use = inann
    is = 0
    for i=0,nz-1 do {
      if counts(i) ge xq then {
	iq = in4annulus(i)
	if isarray(iq) then {
	  in2use(is) = iq
	  is += num_elem(iq)
	}
      }
    }
    in2use = in2use(0:(is-1))
    thann = thann(in2use)
    annth = annth(in2use)
    annthr = annthr(in2use)
    inann = inann(in2use)
    ;so recompute
    key_locations, thann, zonethetas, counts, in4annulus

    ;the indices in in4annulus are for inann (mask annulus)
    nz = num_elem(in4annulus)
    xth = fltarr(nz)
  } else { if $showflag gt 1 then ty,'re-using last annulus' }
 if $showflag gt 1 then ty,'mark 2'
  ;$limbmode is used for different approaches, 0 for EUV, 1 for 1600/1700, 2 for 4500, 3 for 304
  ;4 for HMI
  ;mask is based on original inann
  ;note, we don't use the intensity vs angle for the UV (so don't compute)
  if $limbmode eq 1 then {
    g = sobel(gsmoothy(gsmooth(x,3, masks),3, masks), th, mask2)
    g = sobel(g, th, mask)  ;note g and th are redefined here
  } else {
    g = sobel(gsmoothy(gsmooth(x,3, masks),3, masks), th, mask) ;for 0,2,3
  }
  ;if there was missing data (currently only for venus transit subimages), zero g
  ;for a dilated mask, compute intensive so avoid otherwise
 if $showflag gt 1 then ty,'mark 3'
  if $missvals then {
    missindx = sieve(x lt -100)
    missmask = byte(zero(x))
    missmask(missindx) = 1
    missmask = dilate(missmask)
    missindx = sieve(missmask)
    g(missindx) = 0
  }
  ;annth is the angle for each point (only in annulus)
  ;g is the gradient
  theta = #r2d * th(inann)
  g2 = g(inann)

 if $showflag gt 1 then ty,'mark 4'
  if $showflag then {
    if defined($data0) {
      z = float(zero(x))
      z(inann) = g(inann)
      $data2 = z
      view, 2
      zero, z
      z(inann) = theta
      $data3 = z
      view, 3
      xtloop, 2
    }
  }
  ;mark all within 5 degrees of expected orientation
  if $limbmode eq 3 then da = 5 else da = 5
  if $limbmode eq 2 or $limbmode eq 3 or $limbmode eq 4 then yq = abs(annthr - theta) else yq = abs(annth - theta)
  in2 = sieve(yq le da or yq ge (360-da) and g2 gt 0.0)
  ;in2 are the coordinates within the annular zone with the right orientation
  in3 = inann(in2)
  ;so in3 are the full image coordinates containing orientations within da
  theta3 = thann(in2)
  g3 = g(in3)
  key_locations, theta3, vann3, counts3, g3segs
  nzones = num_elem(vann3)   ;this might not be the full 360
  if $showflag gt 1 then ty,'nzones =', nzones
  xthg3 = fltarr(nzones)
  for i=0,nzones-1 do {
    iq3 = g3segs(i)  	;in g3 
    iq = in3(iq3)		;in original array
    xthg3(i) = mean(x(iq))      ;mean intensity in this zone
  }
  if $showflag then {
    xport, 62
    pencolor, 'black'
    plot, xthg3
    if defined($data0) {
      zero, z
      z(in3) = g3
      $data5 = z
      view, 5
      xtloop, 2
    }
  }
  t2 = !systime
  if $showflag gt 1 then ty, sprintf('setuptime = %7.3f', t2 - t1
  t1 = !systime
  ;make a reduced set, take off the brightest 60 (out of 360) if EUV ($limbmode 0, 3)
 if $showflag gt 1 then ty,'mark 5'
  if $limbmode eq 0 or $limbmode eq 3 then {
    insort = index(xthg3)  ;this has nzones length
    ;8/12/2010 - add a parameter for the amount of "brightness" to omit, $keepfaint
    ;some bad images (partially missing like H2000/AIA20100729_202714_0211.fits) have too
    ;few elements in insort to go on
    ;8/19/2010 - use $keepfaint as a fraction to handle partial circle cases in offset runs
    keepf = fix($keepfaint * num_elem(insort)/360.)
    if $showflag gt 1 then ty,'keeping ', keepf
    if num_elem(insort) lt keepf then return
    infaint = insort(0:(keepf-1))
    nfaint = num_elem(infaint)
  } else {
    ;all are used for $limbmode 1, 2, 4
    infaint = indgen(lonarr(nzones))
    nfaint = num_elem(infaint)
  }
  if $useprevflag then {
    $xcenters = [$sdisk_xc]
    $ycenters = [$sdisk_yc]
    $radiai = [$sdisk_r]
    $scounts = 0
    $pcounts = [$scounts]
  } else {
    ;loop over initial angular zones and find a point in each, we are
    ;only interested in the in3 coords
    if $showflag gt 1 then ty,'nfaint =', nfaint
    ixlimb = fltarr(nfaint)
    iylimb = fltarr(nfaint)
    for j=0,nfaint-1 do {
      i = infaint(j)
      iq = g3segs(i)
      thq = zonethetas(i) * #d2r
      if isarray(iq) then {
	if $limbmode eq 1 or $limbmode eq 3 then {
	  ixy = in3(iq)
	  ;use assumed center to get r for each point
	  rsec = 0.5*sqrt( ((ixy%nx) - xcguess) ^ 2 + ((ixy/nx)- ycguess) ^ 2)
	  if $limbmode eq 3 then rsec = .25 * rsec
	  ;and get the max in the histogram
	  h = hist(rfix(rsec))
	  rq = maxloc(h)
	  rq = 2.0 * rq(0)
	  if $limbmode eq 3 then rq = 4.0 * rq
	  ixlimb(j) = rq * cos(thq) + xcguess
	  iylimb(j) = rq * sin(thq) + ycguess
	  ;median works better than max for UV, but not anymore, use histogram approach above
	  ;xq = g3(iq)
	  ;inmax = index(xq)
	  ;inmax = inmax(num_elem(xq)/2)
	} else {
	  inmax = maxloc(g3(iq))
	  inmax = inmax(0)	;in the subset
	  iq3 = iq(inmax)
	  ixy = in3(iq3)		;in original array
	  ixlimb(j) = ixy%nx
	  iylimb(j) = ixy/nx
	}
      } else {
	;there might not be any in a zone
	ixlimb(j) = 0
	iylimb(j) = 0
      }
    }
    ;in case some zones were not populated
    inq = sieve(ixlimb ne 0)
    if num_elem(inq) ne nfaint then {
      ixlimb = ixlimb(inq)
      iylimb = iylimb(inq)
      nfaint = num_elem(inq)
      ty,'reduced nfaint (some had no points) =', nfaint
    }
    $scounts = num_elem(ixlimb)
    w = zero(fltarr(num_elem(ixlimb))) + 1.0
    circle_fit_lsq, ixlimb, iylimb, w, $sdisk_xc, $sdisk_yc, $sdisk_r, $chicircle
    $xcenters = [$sdisk_xc]
    $ycenters = [$sdisk_yc]
    $radiai   = [$sdisk_r]
    $pcounts  = [$scounts]
    ;;some visual aids (sometimes commented out)
    if $showflag then {
      if defined($data0) {
	zero, z
	;;dump, in3
	z(in3) = g3
	$data6 = z
	pencolor,'red'
	view, 6
	win = 6
	drawlimbpoints, ixlimb, iylimb, win, 'red'
	drawfitcircle, win
	xtloop, 2
      }
    }
    ;the ones inside the circle are the ones most likely to be bad, so get them first
    rdlimb = sqrt( (ixlimb-$sdisk_xc)^2 + (iylimb-$sdisk_yc)^2) - $sdisk_r
    inr = index(rdlimb)
    ;remove all insiders more than 7 pixels from line or 25%, whichever is smaller
    in2use = sieve(rdlimb gt -7.)
    if num_elem(in2use) lt 3*nfaint/4 then {
      in2use = inr( (nfaint/4):*))
    }
    ixlimb2 = ixlimb(in2use)
    iylimb2 = iylimb(in2use)
    w = zero(fltarr(num_elem(ixlimb2))) + 1.0
    circle_fit_lsq, ixlimb2, iylimb2, w, $sdisk_xc, $sdisk_yc, $sdisk_r, $chicircle
    $xcenters = [$xcenters, $sdisk_xc]
    $ycenters = [$ycenters, $sdisk_yc]
    $radiai = [$radiai,$sdisk_r]
    $pcounts = [$pcounts, $scounts]
    if $showflag then {
      if defined($data0) {
	drawlimbpoints, ixlimb2, iylimb2, win, 'green'
	drawfitcircle, win
	xtloop, 2
      }
      xport, 63, 800,800
      pencolor,'black'
      window,.15,.9,.15,.9
      plot,ixlimb,iylimb,-2
      pencolor,'red'
      oplot,ixlimb,iylimb,-2
      pencolor,'green'
      oplot,ixlimb2,iylimb2,-2
      window,.15,.9,.1,.7
    }
  }
 if $showflag gt 1 then ty,'mark 6'

  if $limbmode ne 0 and $limbmode ne 3 then {
    ;for UV, we still have a lot of inside points so try the zeroinonlimb technique
    drs = [50., 35., 25.,15, 10., 5]
    ndr = num_elem(drs)
    for k = 0, ndr-1 do {
      zeroinonlimb, in3, nx, drs(k), g3
      $xcenters = [$xcenters, $sdisk_xc]
      $ycenters = [$ycenters, $sdisk_yc]
      $radiai = [$radiai,$sdisk_r]
      $pcounts = [$pcounts, $scounts]
      //drawfitcircle, win
    }
  }

  t1 = !systime
  ;do a limited range Hough unless 4500 ($limbmode = 2) or HMI ($limbmode = 4)
  if $limbmode eq 2 or $limbmode eq 4 then {
    ;for $limbmode 2, just continue zeroinonlimb
    drs = [3., 2., 1., 1., 1., 1., 1.]
    ndr = num_elem(drs)
    for k = 0, ndr-1 do {
      zeroinonlimb, in3, nx, drs(k), g3
      $xcenters = [$xcenters, $sdisk_xc]
      $ycenters = [$ycenters, $sdisk_yc]
      $radiai = [$radiai,$sdisk_r]
      $pcounts = [$pcounts, $scounts]
      //drawfitcircle, win
    }

  } else {
    ;assume, though, that we are within 10 pixels to reduce candidate points
    ;but make it 15 for 304
    if $limbmode eq 3 then limbtolerance = 15 else limbtolerance = 10
    ixlimb = in3 % nx
    iylimb = in3 / nx
    rdlimb = sqrt( (ixlimb-$sdisk_xc)^2 + (iylimb-$sdisk_yc)^2) - $sdisk_r
    in2use  = sieve(abs(rdlimb) lt limbtolerance)
    ;in2use are indices in in3, make new in3 and theta3
    theta3 = theta3(in2use)
    in3 = in3(in2use)
    g3 = g(in3)	;also redefine g3
    ;that redefined in3, g3, and theta3
    key_locations, theta3, v3, counts3, g3segs
    ;v3 may not have all 360 values
    nv3 = num_elem(v3)

    ;for UV, we don't remove the bright zones but we want local thresholds
    ;want to remove the bright zones, this is awkward
    ;note that v3 and vfaint will be different but both are mono increasing
    nfaint = num_elem(infaint)
    vfaint = vann3(sort(infaint))  ;this is really the same as sort(infaint) usually
    k = 0
    in2use = lonarr(num_elem(theta3))
    is = 0
    if $showflag gt 1 then ty,'nfaint =', nfaint
    for j=0,nfaint-1 do {
      vq = vfaint(j)
      ;;if $showflag gt 2 then ty,'j, k, vq =', j, k, vq
      while (1) { 
	if k lt nv3 then {
	  vq3 = v3(k)
	  ;;if $showflag gt 2 then ty,'vq,vq3 = ',  vq,vq3
	  if vq eq vq3 then {
	    iq = g3segs(k)
	    if isarray(iq) then {
              ;;if $showflag gt 2 then ty,'accepting for j, k, vq =', j, k, vq
	      ;within this sector, compute the mean g and apply a local threshold
	      g4 = g3(iq)
	      if num_elem(g4) gt 1 then { xq = mean(g4)  in2 = sieve(g4 gt 0.9*xq) } else {
	        in2 = 0 }
	      iq = iq(in2)
	      in2use(is) = iq
	      is += num_elem(iq)
	      k += 1
	      if k gt (nv3-1) then 
	      break
	    }
	  } else {
	    if vq3 lt vq then k += 1 else break
	  }
        } else {
	  break
	}
      }
    }
    in2use = in2use(0:(is-1))
    
    in3 = in3(in2use)
    if $sampleflag then {
      wrfits, in3, $samplename
    }
    ;;dump, in3
    ;;theta3 = theta3(in2use)
    ;some visual aids commented out
    if $showflag then {
      if defined($data0) {
	g3 = g3(in2use)	;also redefine g3
	zero, z
	z(in3) = g3
	$data7 = z
	view, 7
	xport,7
	pencolor,'red'
	drawfitcircle, 7
	win = 6
      }
    }
    t2 = !systime
    ;do the Hough iteration
    ;do the iterations in minihough, reduce argument list
    ixlimb = in3 % nx
    iylimb = in3 / nx
    
    stat = minihough(ixlimb, iylimb, 30)
    ;304 has an optional tweak
    if $tweak304flag then {
      $radiai304ns = $radiai
      tweak304, ixlimb, iylimb, 20
    }
    ;or a modified tweak
    if $tweak304flag2 then {
      if $showflag gt 1 then ty,'tweak w/o NS'
      tweak304sansns, ixlimb, iylimb, 20
    }

    if $showflag then {
      ixlimb = in3 % nx
      iylimb = in3 / nx
      rdlimb = (sqrt( (ixlimb-$sdisk_xc)^2 + (iylimb-$sdisk_yc)^2) - $sdisk_r)
      rdlimbi = rfix(rdlimb)
      xport, 64
      pencolor, 'black'
      hr= hist(rdlimbi)
      hx=indgen(hr)+!histmin
      plot,hx,hr, 'radius bin, pixels from converged value', 'number of points'
      if defined($data0) {
	xport,6
	pencolor,'blue'
	drawfitcircle,6
	pencolor, 'black'
	xtloop, 2
      }
    }
    t3 = !systime
    if $showflag gt 1 then ty, sprintf('Hough setup = %7.3f, Hough time = %7.3f', t2-t1, t3-t2)
  }
//   t1 = !systime
//   ;now a fit again, w/o bright sections
//   drs = [3., 2., 1., 1.]
//   ndr = num_elem(drs)
//   for k = 0, ndr-1 do {
//     zeroinonlimb, in3, nx, drs(k), g3
//     $xcenters = [$xcenters, $sdisk_xc]
//     $ycenters = [$ycenters, $sdisk_yc]
//     $radiai = [$radiai,$sdisk_r]
//     $pcounts = [$pcounts, $scounts]
//     drawfitcircle, win
//   }
//   t2 = !systime
//   if $showflag gt 2 then ty, sprintf('last limb fit time = %7.3f', t2 - t1
  
  if $showflag gt 1 then {
    ty,'$xcenters =', $xcenters
    ty,'$ycenters =', $ycenters
    ty,'$radiai =', $radiai
    ty,'$pcounts =', $pcounts
  }
  if $showflag then {
    if num_elem($xcenters) gt 2 then {
      xport,51,512,400  pencolor, 'black'  plot, $xcenters, 'iteration','x center', -4
      xport,52,512,400  pencolor, 'black'  plot, $ycenters, 'iteration','y center', -4
      xport,53,512,400  pencolor, 'black'  plot, $radiai, 'iteration','radius', -4
      if $tweak304flag then {
        xport,53,512,400  pencolor, 'black'  plot, $radiai>$radiai304ns, 'iteration','radius', 0
	oplot, $radiai, -4
        oplot, $radiai304ns, -5 }
      else {
        xport,53,512,400  pencolor, 'black'  plot, $radiai, 'iteration','radius', -4
      }
      xport,54,512,400  pencolor, 'black'  plot, $pcounts, 'iteration','counts', -4
    }
  }
  tlast = !systime
  if $showflag gt 1 then ty, sprintf('total time = %7.3f', tlast - t0
  endsubr
 ;===============================================================================
